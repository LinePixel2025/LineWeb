generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                  @id @default(autoincrement())
  username               String               @unique
  email                  String               @unique
  password               String
  role                   String               @default("author") // 新注册用户默认 author（可发布自己的文章）
  status                 String               @default("active") // pending | active | rejected（注册审核）
  apiRateLimit           Int                  @default(600) @map("api_rate_limit") // 次/15min；0=不限业务配额
  settings               String? // JSON：用户个性化设置（背景类型、颜色等）
  canAccessDrive         Boolean              @default(false) // 是否有网盘访问权限
  storageQuota           BigInt               @default(2147483648) @map("storage_quota") // 网盘空间上限（字节，默认 2 GiB）
  avatarPath             String?              @map("avatar_path") // 存储节点路径（如 _avatars/1.webp）
  tokenValidAfter        DateTime             @default(now()) @map("token_valid_after") // JWT 失效校验基准时间
  gameStatsImportedAt    DateTime?            @map("game_stats_imported_at") // 本地战绩一次性迁移标记
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  posts                  Post[]
  comments               Comment[]
  driveFiles             DriveFile[] // 上传的文件
  driveFavorites         DriveFavorite[]
  screenTimeLogs         ScreenTimeLog[]
  oauthGrants            OAuthGrant[] // 该用户授权过的第三方应用
  createdOAuthClients    OAuthClient[]        @relation("OAuthClientCreatedBy")
  friendshipsA           Friendship[]         @relation("FriendshipUser")
  friendshipsB           Friendship[]         @relation("FriendshipFriend")
  friendRequestsSent     FriendRequest[]      @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[]      @relation("FriendRequestReceiver")
  conversationMembers    ConversationMember[]
  messages               Message[]
  ownedConversations     Conversation[]       @relation("ConversationOwner")
  aiConversations        AiConversation[] // AI 对话（DeepSeek）会话
  aiChatImages           AiChatImage[] // AI 对话上传的图片附件
  proxySites             ProxySite[] // 网页反代站点（含账号级的登录 Cookie）
  gameStats              GameStat[] // 游戏战绩（单机 + 联机）
  siteAnnouncements      SiteAnnouncement[]   @relation("SiteAnnouncementAuthor") // 站点公告（LineWeb 自有，非 neko 群公告）
  siteAnnouncementAcks   SiteAnnouncementAck[] // 站点公告确认记录
  points                 Int                  @default(0) // 游戏积分余额（全游戏统一）
  pointsEarned           Int                  @default(0) @map("points_earned") // 累计获得积分（排行榜 / 成就展示）
  equippedTitleId        Int?                 @map("equipped_title_id") // 当前佩戴的称号（LineWeb 站内展示）
  equippedTitle          PointsShopItem?      @relation("UserEquippedTitle", fields: [equippedTitleId], references: [id], onDelete: SetNull)
  equippedAvatarFrameId  Int?                 @map("equipped_avatar_frame_id") // 当前佩戴的头像框（仅 LineWeb 站内展示，不同步 neko）
  equippedAvatarFrame    PointsShopItem?      @relation("UserEquippedAvatarFrame", fields: [equippedAvatarFrameId], references: [id], onDelete: SetNull)
  equippedLeaderTitleId  Int?                 @map("equipped_leader_title_id") // 当前佩戴的单机榜一传说称号（与商店称号互斥）
  equippedLeaderTitle    GameLeaderTitle?     @relation("UserEquippedLeaderTitle", fields: [equippedLeaderTitleId], references: [id], onDelete: SetNull)
  pointsLedger           PointsLedger[]
  pointsItems            UserPointsItem[]
  checkins               DailyCheckin[]
  leaderTitles           GameLeaderTitle[]
  chatBan                ChatBan?
  farm                   Farm?
  farmStealsMade         FarmSteal[]          @relation("FarmStealThief")
  farmStealsReceived     FarmSteal[]          @relation("FarmStealVictim")
  /**
   * 网页反代排队赦免：不受并发闸门限制（管理员另有 role 兜底）
   */
  proxyQueueExempt       Boolean              @default(false) @map("proxy_queue_exempt")

  @@index([status, createdAt])
  @@map("users")
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  slug      String    @unique
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  authorId  Int       @map("author_id")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([authorId])
  @@index([published, createdAt])
  @@map("posts")
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  postId    Int       @map("post_id")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int?      @map("author_id")
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId  Int?      @map("parent_id")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([postId, createdAt])
  @@map("comments")
}

model Page {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  schema       String // JSON string，存储控件树结构
  published    Boolean  @default(false)
  featured     Boolean  @default(false)
  featureEmoji String? // 功能界面显示的图标 emoji
  featureDesc  String? // 功能界面显示的简介
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([published, featured])
  @@map("pages")
}

model DriveFile {
  id           Int         @id @default(autoincrement())
  name         String // 文件名或文件夹名
  isFolder     Boolean     @default(false) // true = 文件夹
  parentId     Int? // 父文件夹ID（null=根目录）
  parent       DriveFile?  @relation("DriveHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     DriveFile[] @relation("DriveHierarchy")
  size         BigInt      @default(0) // 文件大小（字节）
  mimeType     String? // MIME 类型（文件才有）
  storagePath  String      @unique // 存储节点上的相对路径
  uploadedById Int? // 上传者 ID（null=用户已删除，归属管理员）
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([uploadedById])
  @@index([name])
  @@map("drive_files")
}

model DriveFavorite {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  folderId   Int      @map("folder_id")
  folderName String   @map("folder_name")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId])
  @@index([userId])
  @@map("drive_favorites")
}

model ScreenTimeLog {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String // YYYY-MM-DD
  totalSeconds     Int      @map("total_seconds")
  dailyGoalSeconds Int?     @map("daily_goal_seconds")
  reportedAt       DateTime @map("reported_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("screen_time_logs")
}

model AiConfig {
  id           Int      @id @default(autoincrement())
  provider     String   @default("openai")
  model        String   @default("gpt-4o-mini")
  apiKey       String   @default("")
  baseUrl      String?
  systemPrompt String   @default("你是 LineWeb 网站的 AI 助手，你可以回答关于网站内容、文章、功能等问题。请用中文回答，保持友好、专业的语气。如果用户问到网站没有的信息，请如实告知。")
  isEnabled    Boolean  @default(false)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ai_config")
}

// === AI 对话（DeepSeek）：多会话 + 流式回复 + 每日提问配额 ===

/// AI 对话功能配置 — 全站单行（与首页 AI 助手的 AiConfig 互不影响，
/// 便于图片提问时单独指向支持视觉的模型端点）
model AiChatConfig {
  id             Int      @id @default(autoincrement())
  provider       String   @default("deepseek")
  model          String   @default("deepseek-chat")
  apiKey         String   @default("")
  baseUrl        String?  @default("https://api.deepseek.com")
  systemPrompt   String   @default("你是一个乐于助人的中文 AI 助手。请用中文回答，回答准确、简洁，适当使用 Markdown 格式组织内容。")
  dailyLimit     Int      @default(20) // 每用户每日提问上限；0 = 不限
  isEnabled      Boolean  @default(false)
  // 联网搜索（第三方搜索 API；DeepSeek 官方 API 不自带搜索能力）
  searchEnabled  Boolean  @default(false)
  searchProvider String   @default("bocha") // bocha | tavily
  searchApiKey   String   @default("")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_chat_config")
}

model AiConversation {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("新对话") // 首条消息发出时取内容前 20 字
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  messages  AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id               Int            @id @default(autoincrement())
  conversationId   Int            @map("conversation_id")
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String // 'user' | 'assistant'
  content          String         @default("")
  reasoningContent String?        @map("reasoning_content") // 思考模型的思维链（assistant 消息；非思考为 null）
  model            String? // 生成该回复的模型（assistant 消息）
  counted          Boolean        @default(true) // 是否计入每日提问配额（仅 user 消息；上游调用失败置 false 退还）
  createdAt        DateTime       @default(now()) @map("created_at")
  images           AiChatImage[]

  @@index([conversationId])
  @@map("ai_messages")
}

model AiChatImage {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId Int?       @map("message_id") // null = 已上传、尚未随消息发送的附件
  message   AiMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  imagePath String     @map("image_path") // 存储节点路径：_ai/<userId>/<uuid>.webp
  width     Int
  height    Int
  size      Int // WebP 字节数
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@index([messageId])
  @@map("ai_chat_images")
}

// === 第三方应用授权（OAuth 2.0 授权码 + PKCE） ===

model OAuthClient {
  id            Int      @id @default(autoincrement())
  clientId      String   @unique @map("client_id") // 公开标识，形如 lw_xxxxx
  clientSecret  String?  @map("client_secret") // bcrypt 哈希；公开客户端为 null
  clientType    String   @default("confidential") @map("client_type") // confidential | public
  name          String
  description   String?
  homepage      String?
  redirectUris  String   @map("redirect_uris") // JSON 数组字符串，回调地址需精确匹配
  allowedScopes String   @map("allowed_scopes") // JSON 数组字符串：管理员允许该应用申请的最大 scope 集
  isActive      Boolean  @default(true) @map("is_active")
  createdById   Int?     @map("created_by_id")
  createdBy     User?    @relation("OAuthClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  grants        OAuthGrant[]
  codes         OAuthCode[]
  refreshTokens OAuthRefreshToken[]

  @@index([isActive])
  @@map("oauth_clients")
}

model OAuthGrant {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   Int         @map("client_id")
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes     String // JSON 数组字符串：用户实际同意的 scope
  revokedAt  DateTime?   @map("revoked_at") // 非空 = 用户已撤销授权
  lastUsedAt DateTime?   @map("last_used_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  codes         OAuthCode[]
  refreshTokens OAuthRefreshToken[]

  @@unique([userId, clientId])
  @@index([userId])
  @@map("oauth_grants")
}

model OAuthCode {
  id                  Int         @id @default(autoincrement())
  codeHash            String      @unique @map("code_hash") // 仅存 sha256，明文只回传给应用一次
  grantId             Int         @map("grant_id")
  grant               OAuthGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  clientId            Int         @map("client_id")
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              Int         @map("user_id")
  redirectUri         String      @map("redirect_uri")
  scopes              String // JSON 数组字符串
  codeChallenge       String      @map("code_challenge")
  codeChallengeMethod String      @default("S256") @map("code_challenge_method")
  expiresAt           DateTime    @map("expires_at")
  usedAt              DateTime?   @map("used_at") // 一次性核销标记（防重放）
  createdAt           DateTime    @default(now()) @map("created_at")

  @@index([grantId])
  @@map("oauth_codes")
}

model OAuthRefreshToken {
  id             Int         @id @default(autoincrement())
  tokenHash      String      @unique @map("token_hash") // 仅存 sha256
  grantId        Int         @map("grant_id")
  grant          OAuthGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  clientId       Int         @map("client_id")
  client         OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         Int         @map("user_id")
  scopes         String // JSON 数组字符串
  expiresAt      DateTime    @map("expires_at")
  revokedAt      DateTime?   @map("revoked_at")
  replacedByHash String?     @map("replaced_by_hash") // 轮换后继任令牌的哈希
  lastUsedAt     DateTime?   @map("last_used_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([grantId])
  @@map("oauth_refresh_tokens")
}

// === 好友 / 聊天 ===

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  friendId  Int      @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

model FriendRequest {
  id          Int       @id @default(autoincrement())
  fromUserId  Int       @map("from_user_id")
  toUserId    Int       @map("to_user_id")
  status      String    @default("pending") // pending | accepted | rejected
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")
  fromUser    User      @relation("FriendRequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User      @relation("FriendRequestReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("friend_requests")
}

model Conversation {
  id            Int      @id @default(autoincrement())
  type          String // direct | group
  name          String? // 群名；direct 为 null
  ownerId       Int?     @map("owner_id")
  directKey     String?  @unique @map("direct_key") // direct 会话去重键：`minUserId:maxUserId`
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner    User?                @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id                Int      @id @default(autoincrement())
  conversationId    Int      @map("conversation_id")
  userId            Int      @map("user_id")
  role              String   @default("member") // owner | member
  joinedAt          DateTime @default(now()) @map("joined_at")
  lastReadMessageId Int      @default(0) @map("last_read_message_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  content        String    @default("") // 文本正文；图片消息与已撤回消息为空串
  type           String    @default("text") // text | image
  imagePath      String?   @map("image_path") // 存储节点相对路径 _chat/<conversationId>/<uuid>.webp
  imageWidth     Int?      @map("image_width")
  imageHeight    Int?      @map("image_height")
  imageSize      BigInt?   @map("image_size") // 处理后的字节数（计入网盘配额）
  recalledAt     DateTime? @map("recalled_at") // 非空 = 已撤回
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@index([senderId])
  @@map("messages")
}

model ProxySite {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  name           String
  origin         String // 上游站点源站，形如 https://example.com（无路径、无末尾斜杠）
  cookies        String    @default("[]") // JSON：ProxyCookie[]，站点登录态（跨设备共享）
  /**
   * 强制用桌面浏览器 UA 访问上游（手机打开只服务桌面端的站点时使用）
   */
  forceDesktop   Boolean   @default(false) @map("force_desktop")
  lastVisitedAt  DateTime? @map("last_visited_at")
  /**
   * 访问统计（累计值，由 proxyStats 定时批量累加，不逐请求写库）
   */
  requestCount   Int       @default(0) @map("request_count")
  errorCount     Int       @default(0) @map("error_count")
  lastStatusCode Int?      @map("last_status_code")
  lastErrorAt    DateTime? @map("last_error_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  daily ProxyDailyStat[]

  @@unique([userId, origin])
  @@index([userId])
  @@map("proxy_sites")
}

/**
 * 反代黑名单条目：命中后禁止新建站点与转发请求（pattern 为域名或 *.域名）
 */
model ProxyBlacklist {
  id          Int      @id @default(autoincrement())
  pattern     String   @unique // 归一化后的域名，如 example.com 或 *.example.com
  reason      String? // 拉黑原因（管理端展示）
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("proxy_blacklist")
}

/**
 * 反代每日访问统计（按站点聚合，管理端排名数据源）
 */
model ProxyDailyStat {
  id       Int    @id @default(autoincrement())
  /**
   * 统计日期（Asia/Shanghai），格式 YYYY-MM-DD
   */
  day      String
  siteId   Int    @map("site_id")
  userId   Int    @map("user_id")
  requests Int    @default(0)
  errors   Int    @default(0)

  site ProxySite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([day, siteId])
  @@index([day])
  @@index([userId, day])
  @@map("proxy_daily_stats")
}

// === 站点公告（LineWeb 自有） ===

/**
 * 站点公告：管理员在管理后台发布，全站顶部公告条与聊天页「站点公告」入口展示。
 * 与 neko XMPP 的群公告完全独立（后者的数据在聊天服务里，不落本库）。
 */
model SiteAnnouncement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  level     String   @default("info") // info | success | warning | danger
  isActive  Boolean  @default(true) @map("is_active")
  isPinned  Boolean  @default(false) @map("is_pinned")
  // 首次发布要求用户点「我已知晓」：按公告 id 记一次确认，后续编辑不再重复要求
  requireAck Boolean @default(false) @map("require_ack")
  authorId  Int?     @map("author_id")
  author    User?    @relation("SiteAnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  acknowledgements SiteAnnouncementAck[]

  @@index([isActive, isPinned, createdAt])
  @@map("site_announcements")
}

/** 站点公告确认记录（每个用户对每条公告最多一条） */
model SiteAnnouncementAck {
  id             Int      @id @default(autoincrement())
  announcementId Int      @map("announcement_id")
  userId         Int      @map("user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")
  announcement   SiteAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("site_announcement_acks")
}

/**
 * 站点级键值配置（目前用于绑定 neko 上的 LineWeb 用户大群房间 id）
 * 用独立表而不是写死在环境变量：房间 id 由 neko 自增分配，无法预知。
 */
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// === 站点功能开关 ===

/**
 * 模块级功能开关；缺失的 key 按代码默认值 true 处理
 */
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// === 游戏战绩 ===

/**
 * 游戏战绩聚合（单机 solo / 联机 online / 扫雷难度）
 */
model GameStat {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         String // 2048|doudizhu|snake|minesweeper|jump|gomoku|liar|uno|xiangqi|parkour
  variant      String   @default("solo") // solo|online|beginner|intermediate|expert
  games        Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  deaths       Int      @default(0)
  scoreTotal   Int      @default(0) @map("score_total") // 斗地主积分可为负
  bestScore    Int      @default(0) @map("best_score")
  bestTimeMs   Int?     @map("best_time_ms") // 扫雷最短用时
  bestCombo    Int      @default(0) @map("best_combo")
  bestCoins    Int      @default(0) @map("best_coins")
  bestDistance Float    @default(0) @map("best_distance")
  totalJumps   Int      @default(0) @map("total_jumps")
  offsetSum    Float    @default(0) @map("offset_sum")
  offsetCount  Int      @default(0) @map("offset_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, game, variant])
  @@index([userId])
  @@index([game, variant, bestScore])
  @@index([game, variant, scoreTotal])
  @@index([game, variant, wins])
  @@index([game, variant, bestTimeMs])
  @@map("game_stats")
}

// === 统一积分体系（全游戏通用） ===

/**
 * 积分流水（只追加，不修改）
 * - amount 为实际变动（扣分时最多扣到 0，因此可能小于规则值）
 * - balance 为变动后余额，便于对账
 * - game 为来源游戏（排行榜封顶统计用），商店/农场等非游戏来源为 null
 */
model PointsLedger {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // 正数=获得，负数=扣除
  balance   Int // 变动后余额
  reason    String // game_result | farm_harvest | farm_steal | farm_welcome | farm_shop | farm_expand | farm_merchant | shop_purchase | checkin | leader_bonus | stock | admin_adjust
  game      String? // 来源游戏 id（2048 / doudizhu / ... / farm）
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, game, createdAt])
  @@map("points_ledger")
}

/**
 * 积分规则（单行 JSON）
 * config: { games: Record<gameKey, { win, loss, draw, participation, scoreDivisor, scoreBonusMax, dailyCap, dailyLossCap }>, farm: {...}, checkin: {...}, leaderTitle: {...} }
 * 缺失字段一律回退到代码默认值，管理员只覆盖想改的项。
 */
model PointsConfig {
  id        Int      @id @default(1)
  config    String
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("points_config")
}

/**
 * 积分商店商品：称号（type=title）、专属表情包（type=emoji）与头像框（type=avatar_frame）
 * payload 为 JSON：称号 { color, icon }；表情包 { pack }；头像框 { frame, color }
 */
model PointsShopItem {
  id          Int              @id @default(autoincrement())
  key         String           @unique // 稳定标识，管理员可改展示名但不改 key
  type        String // title | emoji
  name        String
  description String?
  cost        Int
  rarity      String           @default("common") // common | rare | epic | legendary
  payload     String? // JSON
  isActive    Boolean          @default(true) @map("is_active")
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  owners      UserPointsItem[]
  equippedBy  User[]           @relation("UserEquippedTitle")
  avatarFrameEquippedBy User[] @relation("UserEquippedAvatarFrame")

  @@index([type, isActive, sortOrder])
  @@map("points_shop_items")
}

/**
 * 用户已购商品（称号 / 表情包，永久拥有）
 */
model UserPointsItem {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    Int            @map("item_id")
  item      PointsShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_points_items")
}

// === 开心农场 ===

/**
 * 每个用户一块农场（创建即送新手种子与肥料）
 */
model Farm {
  id            Int        @id @default(autoincrement())
  userId        Int        @unique @map("user_id")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String     @default("我的农场")
  plotCount     Int        @default(6) @map("plot_count") // 6 / 9 / 12 / 15 / 18
  tutorialDone  Boolean    @default(false) @map("tutorial_done")
  harvested     Int        @default(0) // 累计收获次数
  harvestPoints Int        @default(0) @map("harvest_points") // 累计收获积分
  stolenPoints  Int        @default(0) @map("stolen_points") // 累计偷菜所得
  lastSeedDropDate String? @map("last_seed_drop_date") // 最近一次每日掉落种子日期（Asia/Shanghai YYYY-MM-DD）
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  plots         FarmPlot[]
  items         FarmItem[]
  merchantOffers FarmMerchantOffer[]

  @@map("farms")
}

/**
 * 农田地块：crop 为空表示空地；yieldUnits 为可收获单位（被偷后减少）
 */
model FarmPlot {
  id          Int       @id @default(autoincrement())
  farmId      Int       @map("farm_id")
  farm        Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  index       Int // 0..plotCount-1
  crop        String? // 作物 key
  plantedAt   DateTime? @map("planted_at")
  readyAt     DateTime? @map("ready_at")
  yieldUnits  Int       @default(0) @map("yield_units")
  stolenCount Int       @default(0) @map("stolen_count")
  fertilized  Int       @default(0) // 已施肥次数（每茬最多 2 次）

  @@unique([farmId, index])
  @@map("farm_plots")
}

/**
 * 农场仓库：种子与肥料（kind = seed | fertilizer）
 */
model FarmItem {
  id      Int    @id @default(autoincrement())
  farmId  Int    @map("farm_id")
  farm    Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  kind    String // seed | fertilizer
  itemKey String @map("item_key")
  count   Int    @default(0)

  @@unique([farmId, kind, itemKey])
  @@map("farm_items")
}

/**
 * 偷菜记录：plotId 不建外键（地块会复用），按 plantedAt 判定同一茬是否已被同一人偷过
 */
model FarmSteal {
  id        Int      @id @default(autoincrement())
  thiefId   Int      @map("thief_id")
  thief     User     @relation("FarmStealThief", fields: [thiefId], references: [id], onDelete: Cascade)
  victimId  Int      @map("victim_id")
  victim    User     @relation("FarmStealVictim", fields: [victimId], references: [id], onDelete: Cascade)
  plotId    Int      @map("plot_id")
  crop      String
  amount    Int
  points    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([thiefId, createdAt])
  @@index([victimId, createdAt])
  @@index([plotId, thiefId, createdAt])
  @@map("farm_steals")
}

/**
 * 随机商人每日报价：每个农场每天一批限购低价商品，跨日重新生成
 */
model FarmMerchantOffer {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  dateKey       String   @map("date_key") // Asia/Shanghai YYYY-MM-DD
  itemKind      String   @map("item_kind") // seed | fertilizer
  itemKey       String   @map("item_key")
  count         Int
  price         Int // 折后总价（积分）
  originalPrice Int      @map("original_price")
  discountPct   Int      @map("discount_pct") // 折扣百分比（60 = 6 折）
  purchased     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([farmId, dateKey, itemKind, itemKey])
  @@index([farmId, dateKey])
  @@map("farm_merchant_offers")
}

/**
 * 每日签到记录（dateKey 唯一保证幂等）
 */
model DailyCheckin {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String   @map("date_key") // Asia/Shanghai YYYY-MM-DD
  streak    Int      @default(1)
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, dateKey])
  @@index([userId, createdAt])
  @@map("daily_checkins")
}

/**
 * 单机排行榜第一位（每个游戏至多一行）；被超过时整行改挂新用户或删除
 */
model GameLeaderTitle {
  id                Int      @id @default(autoincrement())
  game              String   @unique
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  awardedAt         DateTime @default(now()) @map("awarded_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  equippedByUsers   User[]   @relation("UserEquippedLeaderTitle")

  @@index([userId])
  @@map("game_leader_titles")
}

/**
 * 聊天封禁（LineWeb 侧拦截聊天入口，不修改 neko 账号）
 */
model ChatBan {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String    @default("")
  bannedBy  Int?      @map("banned_by")
  active    Boolean   @default(true)
  liftedAt  DateTime? @map("lifted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([active, createdAt])
  @@map("chat_bans")
}
