generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @unique
  password         String
  role             String    @default("user")
  settings         String?   // JSON：用户个性化设置（背景类型、颜色等）
  canAccessDrive   Boolean   @default(false) // 是否有网盘访问权限
  avatarPath       String?   @map("avatar_path") // 存储节点路径（如 _avatars/1.webp）
  tokenValidAfter  DateTime  @default(now()) @map("token_valid_after") // JWT 失效校验基准时间
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  posts            Post[]
  comments         Comment[]
  driveFiles       DriveFile[] // 上传的文件
  apiKeys          ApiKey[]
  screenTimeTokens ScreenTimeToken[]
  screenTimeLogs   ScreenTimeLog[]

  @@map("users")
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  slug      String    @unique
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  authorId  Int       @map("author_id")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([authorId])
  @@index([published, createdAt])
  @@map("posts")
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  postId    Int       @map("post_id")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int?      @map("author_id")
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId  Int?      @map("parent_id")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([postId, createdAt])
  @@map("comments")
}

model Page {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  schema       String   // JSON string，存储控件树结构
  published    Boolean  @default(false)
  featured     Boolean  @default(false)
  featureEmoji String?  // 功能界面显示的图标 emoji
  featureDesc  String?  // 功能界面显示的简介
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([published, featured])
  @@map("pages")
}

model DriveFile {
  id           Int         @id @default(autoincrement())
  name         String                              // 文件名或文件夹名
  isFolder     Boolean     @default(false)         // true = 文件夹
  parentId     Int?                                // 父文件夹ID（null=根目录）
  parent       DriveFile?  @relation("DriveHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     DriveFile[] @relation("DriveHierarchy")
  size         BigInt      @default(0)             // 文件大小（字节）
  mimeType     String?                             // MIME 类型（文件才有）
  storagePath  String   @unique                     // 存储节点上的相对路径
  uploadedById Int?                                // 上传者 ID（null=用户已删除，归属管理员）
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([uploadedById])
  @@index([name])
  @@map("drive_files")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String
  key         String    // 掩码（如 lw_abc...），仅用于展示；认证时用 keyHash 查询
  keyHash     String    @unique @map("key_hash") // sha256(fullKey)，DB 不存完整 key 防泄漏
  prefix      String    @default("lw_")
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  active      Boolean   @default(true)
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("api_keys")
}

model ScreenTimeToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  name      String    @default("Time Master")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("screen_time_tokens")
}

model ScreenTimeLog {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String   // YYYY-MM-DD
  totalSeconds  Int      @map("total_seconds")
  reportedAt    DateTime @map("reported_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("screen_time_logs")
}
