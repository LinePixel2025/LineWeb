generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @unique
  password         String
  role             String    @default("author") // 新注册用户默认 author（可发布自己的文章）
  settings         String?   // JSON：用户个性化设置（背景类型、颜色等）
  canAccessDrive   Boolean   @default(false) // 是否有网盘访问权限
  storageQuota     BigInt    @default(2147483648) @map("storage_quota") // 网盘空间上限（字节，默认 2 GiB）
  avatarPath       String?   @map("avatar_path") // 存储节点路径（如 _avatars/1.webp）
  tokenValidAfter  DateTime  @default(now()) @map("token_valid_after") // JWT 失效校验基准时间
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  posts            Post[]
  comments         Comment[]
  driveFiles       DriveFile[] // 上传的文件
  driveFavorites   DriveFavorite[]
  screenTimeLogs   ScreenTimeLog[]
  oauthGrants      OAuthGrant[] // 该用户授权过的第三方应用
  createdOAuthClients OAuthClient[] @relation("OAuthClientCreatedBy")
  friendshipsA         Friendship[]         @relation("FriendshipUser")
  friendshipsB         Friendship[]         @relation("FriendshipFriend")
  friendRequestsSent   FriendRequest[]      @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[]    @relation("FriendRequestReceiver")
  conversationMembers  ConversationMember[]
  messages             Message[]
  ownedConversations   Conversation[]       @relation("ConversationOwner")

  @@map("users")
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  slug      String    @unique
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  authorId  Int       @map("author_id")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([authorId])
  @@index([published, createdAt])
  @@map("posts")
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  postId    Int       @map("post_id")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int?      @map("author_id")
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId  Int?      @map("parent_id")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([postId, createdAt])
  @@map("comments")
}

model Page {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  schema       String   // JSON string，存储控件树结构
  published    Boolean  @default(false)
  featured     Boolean  @default(false)
  featureEmoji String?  // 功能界面显示的图标 emoji
  featureDesc  String?  // 功能界面显示的简介
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([published, featured])
  @@map("pages")
}

model DriveFile {
  id           Int         @id @default(autoincrement())
  name         String                              // 文件名或文件夹名
  isFolder     Boolean     @default(false)         // true = 文件夹
  parentId     Int?                                // 父文件夹ID（null=根目录）
  parent       DriveFile?  @relation("DriveHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     DriveFile[] @relation("DriveHierarchy")
  size         BigInt      @default(0)             // 文件大小（字节）
  mimeType     String?                             // MIME 类型（文件才有）
  storagePath  String   @unique                     // 存储节点上的相对路径
  uploadedById Int?                                // 上传者 ID（null=用户已删除，归属管理员）
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([uploadedById])
  @@index([name])
  @@map("drive_files")
}

model DriveFavorite {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  folderId   Int      @map("folder_id")
  folderName String   @map("folder_name")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId])
  @@index([userId])
  @@map("drive_favorites")
}

model ScreenTimeLog {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String   // YYYY-MM-DD
  totalSeconds      Int      @map("total_seconds")
  dailyGoalSeconds  Int?     @map("daily_goal_seconds")
  reportedAt        DateTime @map("reported_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("screen_time_logs")
}

model AiConfig {
  id           Int      @id @default(autoincrement())
  provider     String   @default("openai")
  model        String   @default("gpt-4o-mini")
  apiKey       String   @default("")
  baseUrl      String?
  systemPrompt String   @default("你是 LineWeb 网站的 AI 助手，你可以回答关于网站内容、文章、功能等问题。请用中文回答，保持友好、专业的语气。如果用户问到网站没有的信息，请如实告知。")
  isEnabled    Boolean  @default(false)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ai_config")
}

// === 第三方应用授权（OAuth 2.0 授权码 + PKCE） ===

model OAuthClient {
  id            Int      @id @default(autoincrement())
  clientId      String   @unique @map("client_id")      // 公开标识，形如 lw_xxxxx
  clientSecret  String?  @map("client_secret")          // bcrypt 哈希；公开客户端为 null
  clientType    String   @default("confidential") @map("client_type") // confidential | public
  name          String
  description   String?
  homepage      String?
  redirectUris  String   @map("redirect_uris")          // JSON 数组字符串，回调地址需精确匹配
  allowedScopes String   @map("allowed_scopes")         // JSON 数组字符串：管理员允许该应用申请的最大 scope 集
  isActive      Boolean  @default(true) @map("is_active")
  createdById   Int?     @map("created_by_id")
  createdBy     User?    @relation("OAuthClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  grants        OAuthGrant[]
  codes         OAuthCode[]
  refreshTokens OAuthRefreshToken[]

  @@index([isActive])
  @@map("oauth_clients")
}

model OAuthGrant {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   Int       @map("client_id")
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes     String    // JSON 数组字符串：用户实际同意的 scope
  revokedAt  DateTime? @map("revoked_at")    // 非空 = 用户已撤销授权
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  codes         OAuthCode[]
  refreshTokens OAuthRefreshToken[]

  @@unique([userId, clientId])
  @@index([userId])
  @@map("oauth_grants")
}

model OAuthCode {
  id                  Int         @id @default(autoincrement())
  codeHash            String      @unique @map("code_hash")   // 仅存 sha256，明文只回传给应用一次
  grantId             Int         @map("grant_id")
  grant               OAuthGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  clientId            Int         @map("client_id")
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              Int         @map("user_id")
  redirectUri         String      @map("redirect_uri")
  scopes              String      // JSON 数组字符串
  codeChallenge       String      @map("code_challenge")
  codeChallengeMethod String      @default("S256") @map("code_challenge_method")
  expiresAt           DateTime    @map("expires_at")
  usedAt              DateTime?   @map("used_at")            // 一次性核销标记（防重放）
  createdAt           DateTime    @default(now()) @map("created_at")

  @@index([grantId])
  @@map("oauth_codes")
}

model OAuthRefreshToken {
  id             Int         @id @default(autoincrement())
  tokenHash      String      @unique @map("token_hash")      // 仅存 sha256
  grantId        Int         @map("grant_id")
  grant          OAuthGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  clientId       Int         @map("client_id")
  client         OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         Int         @map("user_id")
  scopes         String      // JSON 数组字符串
  expiresAt      DateTime    @map("expires_at")
  revokedAt      DateTime?   @map("revoked_at")
  replacedByHash String?     @map("replaced_by_hash")        // 轮换后继任令牌的哈希
  lastUsedAt     DateTime?   @map("last_used_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([grantId])
  @@map("oauth_refresh_tokens")
}

// === 好友 / 聊天 ===

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  friendId  Int      @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

model FriendRequest {
  id          Int       @id @default(autoincrement())
  fromUserId  Int       @map("from_user_id")
  toUserId    Int       @map("to_user_id")
  status      String    @default("pending") // pending | accepted | rejected
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")
  fromUser    User      @relation("FriendRequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User      @relation("FriendRequestReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("friend_requests")
}

model Conversation {
  id            Int      @id @default(autoincrement())
  type          String   // direct | group
  name          String?  // 群名；direct 为 null
  ownerId       Int?     @map("owner_id")
  directKey     String?  @unique @map("direct_key") // direct 会话去重键：`minUserId:maxUserId`
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner    User?                @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id                Int      @id @default(autoincrement())
  conversationId    Int      @map("conversation_id")
  userId            Int      @map("user_id")
  role              String   @default("member") // owner | member
  joinedAt          DateTime @default(now()) @map("joined_at")
  lastReadMessageId Int      @default(0) @map("last_read_message_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  content        String    @default("") // 文本正文；图片消息与已撤回消息为空串
  type           String    @default("text") // text | image
  imagePath      String?   @map("image_path") // 存储节点相对路径 _chat/<conversationId>/<uuid>.webp
  imageWidth     Int?      @map("image_width")
  imageHeight    Int?      @map("image_height")
  imageSize      BigInt?   @map("image_size") // 处理后的字节数（计入网盘配额）
  recalledAt     DateTime? @map("recalled_at") // 非空 = 已撤回
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@index([senderId])
  @@map("messages")
}
