generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                   @id @default(autoincrement())
  username               String                @unique
  email                  String                @unique
  password               String
  role                   String                @default("author") // 新注册用户默认 author（可发布自己的文章）
  status                 String                @default("active") // pending | active | rejected（注册审核）
  apiRateLimit           Int                   @default(600) @map("api_rate_limit") // 次/15min；0=不限业务配额
  settings               String? // JSON：用户个性化设置（背景类型、颜色等）
  canAccessDrive         Boolean               @default(false) // 是否有网盘访问权限
  storageQuota           BigInt                @default(2147483648) @map("storage_quota") // 网盘空间上限（字节，默认 2 GiB）
  avatarPath             String?               @map("avatar_path") // 存储节点路径（如 _avatars/1.webp）
  avatarVersion          Int                   @default(0) @map("avatar_version") // 聊天头像版本号（上传/删除自增，0 = 无头像）
  chatBackend            String                @default("self") @map("chat_backend") // 聊天后端：self = 自建（默认）| xmpp = neko XMPP（可选）
  tokenValidAfter        DateTime              @default(now()) @map("token_valid_after") // JWT 失效校验基准时间
  gameStatsImportedAt    DateTime?             @map("game_stats_imported_at") // 本地战绩一次性迁移标记
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  posts                  Post[]
  comments               Comment[]
  driveFiles             DriveFile[] // 上传的文件
  driveFavorites         DriveFavorite[]
  screenTimeLogs         ScreenTimeLog[]
  oauthGrants            OAuthGrant[] // 该用户授权过的第三方应用
  createdOAuthClients    OAuthClient[]         @relation("OAuthClientCreatedBy")
  friendshipsA           Friendship[]          @relation("FriendshipUser")
  friendshipsB           Friendship[]          @relation("FriendshipFriend")
  friendRequestsSent     FriendRequest[]       @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[]       @relation("FriendRequestReceiver")
  conversationMembers    ConversationMember[]
  messages               Message[]
  ownedConversations     Conversation[]        @relation("ConversationOwner")
  aiConversations        AiConversation[] // AI 对话（DeepSeek）会话
  aiChatImages           AiChatImage[] // AI 对话上传的图片附件
  proxySites             ProxySite[] // 网页反代站点（含账号级的登录 Cookie）
  gameStats              GameStat[] // 游戏战绩（单机 + 联机）
  siteAnnouncements      SiteAnnouncement[]    @relation("SiteAnnouncementAuthor") // 站点公告（LineWeb 自有，非 neko 群公告）
  siteAnnouncementAcks   SiteAnnouncementAck[] // 站点公告确认记录
  points                 Int                   @default(0) // 游戏积分余额（全游戏统一）
  pointsEarned           Int                   @default(0) @map("points_earned") // 累计获得积分（排行榜 / 成就展示）
  equippedTitleId        Int?                  @map("equipped_title_id") // 当前佩戴的称号（LineWeb 站内展示）
  equippedTitle          PointsShopItem?       @relation("UserEquippedTitle", fields: [equippedTitleId], references: [id], onDelete: SetNull)
  equippedAvatarFrameId  Int?                  @map("equipped_avatar_frame_id") // 当前佩戴的头像框（仅 LineWeb 站内展示，不同步 neko）
  equippedAvatarFrame    PointsShopItem?       @relation("UserEquippedAvatarFrame", fields: [equippedAvatarFrameId], references: [id], onDelete: SetNull)
  equippedLeaderTitleId  Int?                  @map("equipped_leader_title_id") // 当前佩戴的单机榜一传说称号（与商店称号互斥）
  equippedLeaderTitle    GameLeaderTitle?      @relation("UserEquippedLeaderTitle", fields: [equippedLeaderTitleId], references: [id], onDelete: SetNull)
  stockHoldings          StockHolding[] // 模拟股市持仓
  pointsLedger           PointsLedger[]
  pointsItems            UserPointsItem[]
  checkins               DailyCheckin[]
  leaderTitles           GameLeaderTitle[]
  chatBan                ChatBan?
  pet                    Pet?
  equippedThemeKey       String?               @map("equipped_theme_key") // 当前佩戴的 LineWeb 主题 key（目录见 server/src/lib/themes.ts）
  stockAccount           StockAccount? // 股市账户（分红水位 / 累计分红 / 已实现盈亏）
  stockTrades            StockTrade[] // 股市成交记录
  lotteryAccount         LotteryAccount? // 抽奖账户（保底计数 / 累计抽数）
  lotteryDraws           LotteryDraw[] // 抽奖记录
  themeUnlocks           ThemeUnlock[] // 已解锁的 LineWeb 主题
  petGuestbook           PetGuestbook[]        @relation("PetGuestbookAuthor") // 我在别人宠物之家留的言
  petVisits              PetVisit[]            @relation("PetVisitVisitor") // 我串门撸宠的记录
  petBattlesAsChallenger PetBattle[]           @relation("PetBattleChallenger") // 我发起的宠物对战
  petBattlesAsOpponent   PetBattle[]           @relation("PetBattleOpponent") // 我应战的宠物对战
  petMarketListings      PetMarketListing[]    @relation("PetMarketSeller") // 我挂出的交易行条目
  petMarketPurchases     PetMarketListing[]    @relation("PetMarketBuyer") // 我在交易行买下的条目
  petMarketTradesSold    PetMarketTrade[]      @relation("PetMarketTradeSeller") // 我作为卖家的成交记录
  petMarketTradesBought  PetMarketTrade[]      @relation("PetMarketTradeBuyer") // 我作为买家的成交记录
  petRaid                PetRaid? // 进行中的宠物搜打撤对局（每人至多一局）
  petRaidRecords         PetRaidRecord[] // 搜打撤战绩
  petRaidContracts       PetRaidContract[] // 搜打撤每日契约
  raidStorage            RaidStorage? // 搜打撤仓库（等级决定容量与保险箱格数）
  raidInventoryItems     RaidInventoryItem[] // 搜打撤仓库物品（按物品聚合）
  raidMarketListingsSold   RaidMarketListing[] @relation("RaidMarketListingSeller") // 我挂出的搜打撤交易行条目
  raidMarketListingsBought RaidMarketListing[] @relation("RaidMarketListingBuyer") // 我买下的搜打撤交易行条目
  farmSeedListings       FarmSeedListing[]     @relation("FarmSeedSeller") // 我挂出的种子
  farmSeedPurchases      FarmSeedListing[]     @relation("FarmSeedBuyer") // 我买下的种子
  stockOrders            StockOrder[] // 股市限价委托
  personalSpace          PersonalSpace? // 个人空间（管理员私人服务，每管理员一份）
  books                  Book[] // 小说阅读器的书架（上传的书）
  musicAccount           MusicAccount? // 网易云音乐扫码绑定的账号（cookie 仅存服务端）
  farm                   Farm?
  farmStealsMade         FarmSteal[]           @relation("FarmStealThief")
  farmStealsReceived     FarmSteal[]           @relation("FarmStealVictim")
  chatUploads            ChatUpload[] // 聊天图片/表情上传
  chatStickers           ChatSticker[] // 聊天表情收藏
  chatRemarksOwned       ChatContactSetting[]  @relation("ChatContactOwner") // 我给别人设置的备注
  chatRemarksTarget      ChatContactSetting[]  @relation("ChatContactTarget") // 别人给我的备注行（仅对方视角）
  sentRedPackets         RedPacket[]           @relation("RedPacketSender") // 我发出的聊天红包
  redPacketClaims        RedPacketClaim[] // 我领取的红包记录
  /**
   * 网页反代排队赦免：不受并发闸门限制（管理员另有 role 兜底）
   */
  proxyQueueExempt       Boolean               @default(false) @map("proxy_queue_exempt")

  @@index([status, createdAt])
  @@map("users")
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  slug      String    @unique
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  authorId  Int       @map("author_id")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([authorId])
  @@index([published, createdAt])
  @@map("posts")
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  postId    Int       @map("post_id")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int?      @map("author_id")
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId  Int?      @map("parent_id")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([postId, createdAt])
  @@map("comments")
}

model Page {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  schema       String // JSON string，存储控件树结构
  published    Boolean  @default(false)
  featured     Boolean  @default(false)
  featureEmoji String? // 功能界面显示的图标 emoji
  featureDesc  String? // 功能界面显示的简介
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([published, featured])
  @@map("pages")
}

model DriveFile {
  id           Int         @id @default(autoincrement())
  name         String // 文件名或文件夹名
  isFolder     Boolean     @default(false) // true = 文件夹
  isPublic     Boolean     @default(false) @map("is_public") // true = 公共网盘文件/文件夹（管理员维护，全员只读）
  parentId     Int? // 父文件夹ID（null=根目录）
  parent       DriveFile?  @relation("DriveHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     DriveFile[] @relation("DriveHierarchy")
  size         BigInt      @default(0) // 文件大小（字节）
  mimeType     String? // MIME 类型（文件才有）
  storagePath  String      @unique // 存储节点上的相对路径
  uploadedById Int? // 上传者 ID（null=用户已删除，归属管理员）
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([uploadedById])
  @@index([name])
  @@map("drive_files")
}

model DriveFavorite {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  folderId   Int      @map("folder_id")
  folderName String   @map("folder_name")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId])
  @@index([userId])
  @@map("drive_favorites")
}

model ScreenTimeLog {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String // YYYY-MM-DD
  totalSeconds     Int      @map("total_seconds")
  dailyGoalSeconds Int?     @map("daily_goal_seconds")
  reportedAt       DateTime @map("reported_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("screen_time_logs")
}

model AiConfig {
  id           Int      @id @default(autoincrement())
  provider     String   @default("openai")
  model        String   @default("gpt-4o-mini")
  apiKey       String   @default("")
  baseUrl      String?
  systemPrompt String   @default("你是 LineWeb 网站的 AI 助手，你可以回答关于网站内容、文章、功能等问题。请用中文回答，保持友好、专业的语气。如果用户问到网站没有的信息，请如实告知。")
  isEnabled    Boolean  @default(false)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ai_config")
}

// === AI 对话（DeepSeek）：多会话 + 流式回复 + 每日提问配额 ===

/// AI 对话功能配置 — 全站单行（与首页 AI 助手的 AiConfig 互不影响，
/// 便于图片提问时单独指向支持视觉的模型端点）
model AiChatConfig {
  id             Int      @id @default(autoincrement())
  provider       String   @default("deepseek")
  model          String   @default("deepseek-chat")
  apiKey         String   @default("")
  baseUrl        String?  @default("https://api.deepseek.com")
  systemPrompt   String   @default("你是一个乐于助人的中文 AI 助手。请用中文回答，回答准确、简洁，适当使用 Markdown 格式组织内容。")
  dailyLimit     Int      @default(20) // 每用户每日提问上限；0 = 不限
  isEnabled      Boolean  @default(false)
  // 联网搜索（第三方搜索 API；DeepSeek 官方 API 不自带搜索能力）
  searchEnabled  Boolean  @default(false)
  searchProvider String   @default("bocha") // bocha | tavily
  searchApiKey   String   @default("")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_chat_config")
}

model AiConversation {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("新对话") // 首条消息发出时取内容前 20 字
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  messages  AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id               Int            @id @default(autoincrement())
  conversationId   Int            @map("conversation_id")
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String // 'user' | 'assistant'
  content          String         @default("")
  reasoningContent String?        @map("reasoning_content") // 思考模型的思维链（assistant 消息；非思考为 null）
  model            String? // 生成该回复的模型（assistant 消息）
  counted          Boolean        @default(true) // 是否计入每日提问配额（仅 user 消息；上游调用失败置 false 退还）
  createdAt        DateTime       @default(now()) @map("created_at")
  images           AiChatImage[]

  @@index([conversationId])
  @@map("ai_messages")
}

model AiChatImage {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId Int?       @map("message_id") // null = 已上传、尚未随消息发送的附件
  message   AiMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  imagePath String     @map("image_path") // 存储节点路径：_ai/<userId>/<uuid>.webp
  width     Int
  height    Int
  size      Int // WebP 字节数
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@index([messageId])
  @@map("ai_chat_images")
}

// === 第三方应用授权（OAuth 2.0 授权码 + PKCE） ===

model OAuthClient {
  id            Int      @id @default(autoincrement())
  clientId      String   @unique @map("client_id") // 公开标识，形如 lw_xxxxx
  clientSecret  String?  @map("client_secret") // bcrypt 哈希；公开客户端为 null
  clientType    String   @default("confidential") @map("client_type") // confidential | public
  name          String
  description   String?
  homepage      String?
  redirectUris  String   @map("redirect_uris") // JSON 数组字符串，回调地址需精确匹配
  allowedScopes String   @map("allowed_scopes") // JSON 数组字符串：管理员允许该应用申请的最大 scope 集
  isActive      Boolean  @default(true) @map("is_active")
  createdById   Int?     @map("created_by_id")
  createdBy     User?    @relation("OAuthClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  grants        OAuthGrant[]
  codes         OAuthCode[]
  refreshTokens OAuthRefreshToken[]

  @@index([isActive])
  @@map("oauth_clients")
}

model OAuthGrant {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   Int         @map("client_id")
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes     String // JSON 数组字符串：用户实际同意的 scope
  revokedAt  DateTime?   @map("revoked_at") // 非空 = 用户已撤销授权
  lastUsedAt DateTime?   @map("last_used_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  codes         OAuthCode[]
  refreshTokens OAuthRefreshToken[]

  @@unique([userId, clientId])
  @@index([userId])
  @@map("oauth_grants")
}

model OAuthCode {
  id                  Int         @id @default(autoincrement())
  codeHash            String      @unique @map("code_hash") // 仅存 sha256，明文只回传给应用一次
  grantId             Int         @map("grant_id")
  grant               OAuthGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  clientId            Int         @map("client_id")
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              Int         @map("user_id")
  redirectUri         String      @map("redirect_uri")
  scopes              String // JSON 数组字符串
  codeChallenge       String      @map("code_challenge")
  codeChallengeMethod String      @default("S256") @map("code_challenge_method")
  expiresAt           DateTime    @map("expires_at")
  usedAt              DateTime?   @map("used_at") // 一次性核销标记（防重放）
  createdAt           DateTime    @default(now()) @map("created_at")

  @@index([grantId])
  @@map("oauth_codes")
}

model OAuthRefreshToken {
  id             Int         @id @default(autoincrement())
  tokenHash      String      @unique @map("token_hash") // 仅存 sha256
  grantId        Int         @map("grant_id")
  grant          OAuthGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  clientId       Int         @map("client_id")
  client         OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         Int         @map("user_id")
  scopes         String // JSON 数组字符串
  expiresAt      DateTime    @map("expires_at")
  revokedAt      DateTime?   @map("revoked_at")
  replacedByHash String?     @map("replaced_by_hash") // 轮换后继任令牌的哈希
  lastUsedAt     DateTime?   @map("last_used_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([grantId])
  @@map("oauth_refresh_tokens")
}

// === 好友 / 聊天 ===

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  friendId  Int      @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

model FriendRequest {
  id          Int       @id @default(autoincrement())
  fromUserId  Int       @map("from_user_id")
  toUserId    Int       @map("to_user_id")
  status      String    @default("pending") // pending | accepted | rejected
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")
  fromUser    User      @relation("FriendRequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User      @relation("FriendRequestReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("friend_requests")
}

model Conversation {
  id                      Int       @id @default(autoincrement())
  type                    String // direct | group
  name                    String? // 群名；direct 为 null
  ownerId                 Int?      @map("owner_id")
  directKey               String?   @unique @map("direct_key") // direct 会话去重键：`minUserId:maxUserId`
  lastMessageAt           DateTime  @default(now()) @map("last_message_at")
  // 自建聊天（2026-10 起）：群公告与全员禁言（与旧 neko 群语义对齐）
  announcementText        String?   @map("announcement_text")
  announcementUpdatedAt   DateTime? @map("announcement_updated_at")
  announcementAckRequired Boolean   @default(false) @map("announcement_ack_required")
  allMuted                Boolean   @default(false) @map("all_muted")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  owner      User?                @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members    ConversationMember[]
  messages   Message[]
  redPackets RedPacket[] // 会话内的积分红包

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id                      Int       @id @default(autoincrement())
  conversationId          Int       @map("conversation_id")
  userId                  Int       @map("user_id")
  role                    String    @default("member") // owner | admin | member
  joinedAt                DateTime  @default(now()) @map("joined_at")
  lastReadMessageId       Int       @default(0) @map("last_read_message_id")
  // 自建聊天（2026-10 起）：会话级偏好与群管理状态
  notifyMuted             Boolean   @default(false) @map("notify_muted") // 群免打扰（只提醒 @我 与拍一拍）
  pinned                  Boolean   @default(false) // 会话置顶
  announcementConfirmedAt DateTime? @map("announcement_confirmed_at") // 最近一次确认群公告的时间
  mutedUntil              DateTime? @map("muted_until") // 被禁言截止时间（null = 未禁言）

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  content        String    @default("") // 文本正文；图片消息与已撤回消息为空串
  type           String    @default("text") // text | image
  imagePath      String?   @map("image_path") // 存储节点相对路径（旧存档：_chat/<conversationId>/<uuid>.webp）
  imageWidth     Int?      @map("image_width")
  imageHeight    Int?      @map("image_height")
  imageSize      BigInt?   @map("image_size") // 处理后的字节数（计入网盘配额）
  recalledAt     DateTime? @map("recalled_at") // 非空 = 已撤回
  // 自建聊天（2026-10 起）：引用 / @ / 富文本 / 合并转发快照
  replyToId      Int?      @map("reply_to_id")
  mentions       String? // JSON 数组：被 @ 的 neko id（0 = @所有人）
  xhtml          String? // 净化后的 XHTML-IM 片段（图片/表情/拍一拍）
  forwardBundle  String?   @map("forward_bundle") // 合并转发快照 JSON（[{u,n,t,b,h,r}…]）
  recalledBy     Int?      @map("recalled_by") // 执行撤回的用户（群主/管理员撤回时 ≠ senderId）
  uploadId       String?   @map("upload_id") // 24hex：引用的 ChatUpload（撤回时判断图片是否仍被其它消息引用）
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, id])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

/**
 * 聊天图片/表情上传（raw body 直传，24hex id；存储节点 _chat/uploads/，storageSync 排除）
 */
model ChatUpload {
  id        String   @id // 24 位小写 hex
  ownerId   Int      @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  path      String // 存储节点路径 _chat/uploads/<id>.<ext>
  mime      String
  size      Int // 处理后字节数（写入消息行 imageSize 的来源）
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@map("chat_uploads")
}

/**
 * 聊天表情收藏（引用 ChatUpload 的 24hex id）
 */
model ChatSticker {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId  String   @map("upload_id") // 24 位小写 hex
  mime      String   @default("image/png")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, uploadId])
  @@index([userId])
  @@map("chat_stickers")
}

/**
 * 聊天积分红包（单聊专属：对方领全部；群聊拼手气：N 份二倍均值随机；24h 未领完惰性退回）
 */
model RedPacket {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  senderId       Int      @map("sender_id")
  totalPoints    Int      @map("total_points")
  count          Int // 份数（single 恒为 1）
  type           String // single | lucky
  greeting       String   @default("")
  status         String   @default("active") // active | finished | expired
  claimedPoints  Int      @default(0) @map("claimed_points")
  claimedCount   Int      @default(0) @map("claimed_count")
  expireAt       DateTime @map("expire_at") // 创建 + 24h，过期未领完退回发送者
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("RedPacketSender", fields: [senderId], references: [id], onDelete: Cascade)
  claims       RedPacketClaim[]

  @@index([conversationId, createdAt])
  @@index([status, expireAt])
  @@map("red_packets")
}

/**
 * 红包领取记录（一个红包一人最多领一次）
 */
model RedPacketClaim {
  id          Int      @id @default(autoincrement())
  redPacketId Int      @map("red_packet_id")
  userId      Int      @map("user_id")
  amount      Int
  claimedAt   DateTime @default(now()) @map("claimed_at")

  redPacket RedPacket @relation(fields: [redPacketId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([redPacketId, userId])
  @@index([userId])
  @@map("red_packet_claims")
}

/**
 * 联系人备注（仅自己可见；≤30 字）
 */
model ChatContactSetting {
  id           Int      @id @default(autoincrement())
  ownerId      Int      @map("owner_id")
  owner        User     @relation("ChatContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUserId Int      @map("target_user_id")
  target       User     @relation("ChatContactTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  remark       String   @default("")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([ownerId, targetUserId])
  @@index([targetUserId])
  @@map("chat_contact_settings")
}

model ProxySite {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  name           String
  origin         String // 上游站点源站，形如 https://example.com（无路径、无末尾斜杠）
  cookies        String    @default("[]") // JSON：ProxyCookie[]，站点登录态（跨设备共享）
  /**
   * 强制用桌面浏览器 UA 访问上游（手机打开只服务桌面端的站点时使用）
   */
  forceDesktop   Boolean   @default(false) @map("force_desktop")
  lastVisitedAt  DateTime? @map("last_visited_at")
  /**
   * 访问统计（累计值，由 proxyStats 定时批量累加，不逐请求写库）
   */
  requestCount   Int       @default(0) @map("request_count")
  errorCount     Int       @default(0) @map("error_count")
  lastStatusCode Int?      @map("last_status_code")
  lastErrorAt    DateTime? @map("last_error_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  daily ProxyDailyStat[]

  @@unique([userId, origin])
  @@index([userId])
  @@map("proxy_sites")
}

/**
 * 反代黑名单条目：命中后禁止新建站点与转发请求（pattern 为域名或 *.域名）
 */
model ProxyBlacklist {
  id          Int      @id @default(autoincrement())
  pattern     String   @unique // 归一化后的域名，如 example.com 或 *.example.com
  reason      String? // 拉黑原因（管理端展示）
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("proxy_blacklist")
}

/**
 * 反代每日访问统计（按站点聚合，管理端排名数据源）
 */
model ProxyDailyStat {
  id       Int    @id @default(autoincrement())
  /**
   * 统计日期（Asia/Shanghai），格式 YYYY-MM-DD
   */
  day      String
  siteId   Int    @map("site_id")
  userId   Int    @map("user_id")
  requests Int    @default(0)
  errors   Int    @default(0)

  site ProxySite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([day, siteId])
  @@index([day])
  @@index([userId, day])
  @@map("proxy_daily_stats")
}

// === 站点公告（LineWeb 自有） ===

/**
 * 站点公告：管理员在管理后台发布，全站顶部公告条与聊天页「站点公告」入口展示。
 * 与 neko XMPP 的群公告完全独立（后者的数据在聊天服务里，不落本库）。
 */
model SiteAnnouncement {
  id               Int                   @id @default(autoincrement())
  title            String
  content          String
  level            String                @default("info") // info | success | warning | danger
  isActive         Boolean               @default(true) @map("is_active")
  isPinned         Boolean               @default(false) @map("is_pinned")
  // 首次发布要求用户点「我已知晓」：按公告 id 记一次确认，后续编辑不再重复要求
  requireAck       Boolean               @default(false) @map("require_ack")
  authorId         Int?                  @map("author_id")
  author           User?                 @relation("SiteAnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  acknowledgements SiteAnnouncementAck[]

  @@index([isActive, isPinned, createdAt])
  @@map("site_announcements")
}

/**
 * 站点公告确认记录（每个用户对每条公告最多一条）
 */
model SiteAnnouncementAck {
  id             Int              @id @default(autoincrement())
  announcementId Int              @map("announcement_id")
  userId         Int              @map("user_id")
  acknowledgedAt DateTime         @default(now()) @map("acknowledged_at")
  announcement   SiteAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("site_announcement_acks")
}

/**
 * 站点级键值配置（目前用于绑定 neko 上的 LineWeb 用户大群房间 id）
 * 用独立表而不是写死在环境变量：房间 id 由 neko 自增分配，无法预知。
 */
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// === 站点功能开关 ===

/**
 * 模块级功能开关；缺失的 key 按代码默认值 true 处理
 */
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// === 游戏战绩 ===

/**
 * 游戏战绩聚合（单机 solo / 联机 online / 扫雷难度）
 */
model GameStat {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         String // 2048|doudizhu|snake|minesweeper|jump|gomoku|liar|uno|xiangqi|parkour
  variant      String   @default("solo") // solo|online|beginner|intermediate|expert
  games        Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  deaths       Int      @default(0)
  scoreTotal   Int      @default(0) @map("score_total") // 斗地主积分可为负
  bestScore    Int      @default(0) @map("best_score")
  bestTimeMs   Int?     @map("best_time_ms") // 扫雷最短用时
  bestCombo    Int      @default(0) @map("best_combo")
  bestCoins    Int      @default(0) @map("best_coins")
  bestDistance Float    @default(0) @map("best_distance")
  totalJumps   Int      @default(0) @map("total_jumps")
  offsetSum    Float    @default(0) @map("offset_sum")
  offsetCount  Int      @default(0) @map("offset_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, game, variant])
  @@index([userId])
  @@index([game, variant, bestScore])
  @@index([game, variant, scoreTotal])
  @@index([game, variant, wins])
  @@index([game, variant, bestTimeMs])
  @@map("game_stats")
}

// === 统一积分体系（全游戏通用） ===

/**
 * 积分流水（只追加，不修改）
 * - amount 为实际变动（扣分时最多扣到 0，因此可能小于规则值）
 * - balance 为变动后余额，便于对账
 * - game 为来源游戏（排行榜封顶统计用），商店/农场等非游戏来源为 null
 */
model PointsLedger {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // 正数=获得，负数=扣除
  balance   Int // 变动后余额
  reason    String // game_result | farm_harvest | farm_steal | farm_welcome | farm_shop | farm_expand | farm_merchant | farm_protect | farm_seed_buy | farm_seed_sell | shop_purchase | checkin | leader_bonus | stock | stock_order_buy | stock_order_refund | stock_order_sell | pet_raid | pet_raid_entry | pet_raid_insurance | pet_raid_contract | raid_recycle | raid_market_sell | raid_market_buy | raid_storage_upgrade | redpacket_send | redpacket_receive | redpacket_refund | admin_adjust
  game      String? // 来源游戏 id（2048 / doudizhu / ... / farm）
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, game, createdAt])
  @@map("points_ledger")
}

/**
 * 积分规则（单行 JSON）
 * config: { games: Record<gameKey, { win, loss, draw, participation, scoreDivisor, scoreBonusMax, dailyCap, dailyLossCap }>, farm: {...}, checkin: {...}, leaderTitle: {...} }
 * 缺失字段一律回退到代码默认值，管理员只覆盖想改的项。
 */
model PointsConfig {
  id        Int      @id @default(1)
  config    String
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("points_config")
}

/**
 * 积分商店商品：称号（type=title）、专属表情包（type=emoji）与头像框（type=avatar_frame）
 * payload 为 JSON：称号 { color, icon }；表情包 { pack }；头像框 { frame, color }
 */
model PointsShopItem {
  id                    Int              @id @default(autoincrement())
  key                   String           @unique // 稳定标识，管理员可改展示名但不改 key
  type                  String // title | emoji
  name                  String
  description           String?
  cost                  Int
  rarity                String           @default("common") // common | rare | epic | legendary
  payload               String? // JSON
  isActive              Boolean          @default(true) @map("is_active")
  sortOrder             Int              @default(0) @map("sort_order")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  owners                UserPointsItem[]
  equippedBy            User[]           @relation("UserEquippedTitle")
  avatarFrameEquippedBy User[]           @relation("UserEquippedAvatarFrame")

  @@index([type, isActive, sortOrder])
  @@map("points_shop_items")
}

/**
 * 用户已购商品（称号 / 表情包，永久拥有）
 */
model UserPointsItem {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    Int            @map("item_id")
  item      PointsShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_points_items")
}

// === 开心农场 ===

/**
 * 每个用户一块农场（创建即送新手种子与肥料）
 */
model Farm {
  id               Int                 @id @default(autoincrement())
  userId           Int                 @unique @map("user_id")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String              @default("我的农场")
  plotCount        Int                 @default(6) @map("plot_count") // 6 / 9 / 12 / 15 / 18 / 21 / 24 / 27 / 30
  tutorialDone     Boolean             @default(false) @map("tutorial_done")
  harvested        Int                 @default(0) // 累计收获次数
  harvestPoints    Int                 @default(0) @map("harvest_points") // 累计收获积分
  stolenPoints     Int                 @default(0) @map("stolen_points") // 累计偷菜所得
  /**
   * 农场保护到期时间（花积分购买，期间任何人都不能偷）
   */
  protectedUntil   DateTime?           @map("protected_until")
  lastSeedDropDate String?             @map("last_seed_drop_date") // 最近一次每日掉落种子日期（Asia/Shanghai YYYY-MM-DD）
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  plots            FarmPlot[]
  items            FarmItem[]
  merchantOffers   FarmMerchantOffer[]

  @@map("farms")
}

/**
 * 农田地块：crop 为空表示空地；yieldUnits 为可收获单位（被偷后减少）
 */
model FarmPlot {
  id          Int       @id @default(autoincrement())
  farmId      Int       @map("farm_id")
  farm        Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  index       Int // 0..plotCount-1
  crop        String? // 作物 key
  plantedAt   DateTime? @map("planted_at")
  readyAt     DateTime? @map("ready_at")
  yieldUnits  Int       @default(0) @map("yield_units")
  stolenCount Int       @default(0) @map("stolen_count")
  fertilized  Int       @default(0) // 已施肥次数（每茬最多 2 次）

  @@unique([farmId, index])
  @@map("farm_plots")
}

/**
 * 农场仓库：种子与肥料（kind = seed | fertilizer）
 */
model FarmItem {
  id      Int    @id @default(autoincrement())
  farmId  Int    @map("farm_id")
  farm    Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  kind    String // seed | fertilizer
  itemKey String @map("item_key")
  count   Int    @default(0)

  @@unique([farmId, kind, itemKey])
  @@map("farm_items")
}

/**
 * 偷菜记录：plotId 不建外键（地块会复用），按 plantedAt 判定同一茬是否已被同一人偷过
 */
model FarmSteal {
  id        Int      @id @default(autoincrement())
  thiefId   Int      @map("thief_id")
  thief     User     @relation("FarmStealThief", fields: [thiefId], references: [id], onDelete: Cascade)
  victimId  Int      @map("victim_id")
  victim    User     @relation("FarmStealVictim", fields: [victimId], references: [id], onDelete: Cascade)
  plotId    Int      @map("plot_id")
  crop      String
  amount    Int
  points    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([thiefId, createdAt])
  @@index([victimId, createdAt])
  @@index([plotId, thiefId, createdAt])
  @@map("farm_steals")
}

/**
 * 随机商人每日报价：每个农场每天一批限购低价商品，跨日重新生成
 */
model FarmMerchantOffer {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  dateKey       String   @map("date_key") // Asia/Shanghai YYYY-MM-DD
  itemKind      String   @map("item_kind") // seed | fertilizer
  itemKey       String   @map("item_key")
  count         Int
  price         Int // 折后总价（积分）
  originalPrice Int      @map("original_price")
  discountPct   Int      @map("discount_pct") // 折扣百分比（60 = 6 折）
  purchased     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([farmId, dateKey, itemKind, itemKey])
  @@index([farmId, dateKey])
  @@map("farm_merchant_offers")
}

/**
 * 玩家间种子交易挂单：挂单时把种子从卖家仓库扣除（托管），
 * 成交后进入买家仓库；取消/过期原路返还。price 为整单总价（积分）。
 */
model FarmSeedListing {
  id        Int       @id @default(autoincrement())
  sellerId  Int       @map("seller_id")
  seller    User      @relation("FarmSeedSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  cropKey   String    @map("crop_key")
  count     Int
  price     Int
  status    String    @default("active") // active | sold | cancelled
  buyerId   Int?      @map("buyer_id")
  buyer     User?     @relation("FarmSeedBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  soldAt    DateTime? @map("sold_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status, cropKey, createdAt])
  @@index([sellerId, status])
  @@map("farm_seed_listings")
}

/**
 * 每日签到记录（dateKey 唯一保证幂等）
 */
model DailyCheckin {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String   @map("date_key") // Asia/Shanghai YYYY-MM-DD
  streak    Int      @default(1)
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, dateKey])
  @@index([userId, createdAt])
  @@map("daily_checkins")
}

/**
 * 单机排行榜第一位（每个游戏至多一行）；被超过时整行改挂新用户或删除
 */
model GameLeaderTitle {
  id              Int      @id @default(autoincrement())
  game            String   @unique
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 传说称号特效（TITLE_EFFECT_STYLES 白名单，管理员可改；重算 upsert 不写该字段故不会覆盖）
  effect          String   @default("classic")
  awardedAt       DateTime @default(now()) @map("awarded_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  equippedByUsers User[]   @relation("UserEquippedLeaderTitle")

  @@index([userId])
  @@map("game_leader_titles")
}

/**
 * 模拟股市持仓（积分投资；行情由日期确定性生成，不设真实标的）
 */
model StockHolding {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String // 股票代码（STOCK_DEFINITIONS）
  shares     Float // 持有份额（按买入价折算，允许小数）
  costPoints Int      @map("cost_points") // 累计投入积分（含买入手续费）
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, code])
  @@index([code])
  @@map("stock_holdings")
}

/**
 * 聊天封禁（LineWeb 侧拦截聊天入口，不修改 neko 账号）
 */
model ChatBan {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String    @default("")
  bannedBy  Int?      @map("banned_by")
  active    Boolean   @default(true)
  liftedAt  DateTime? @map("lifted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([active, createdAt])
  @@map("chat_bans")
}

// === 宠物 ===

/**
 * 每用户一只宠物（userId 唯一）；离家出走（status='gone'）后召唤同一行重置，已购装扮（PetOutfit）保留。
 * hunger / cleanliness / mood 为 0–100 的连续值，按 PET_DECAY_PER_HOUR 线性衰减，读取时惰性结算。
 */
model Pet {
  id            Int            @id @default(autoincrement())
  userId        Int            @unique @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  species       String // 物种 key（PET_SPECIES：cat | dog | bird）
  name          String         @default("小宠物")
  level         Int            @default(1)
  hunger        Float          @default(100)
  cleanliness   Float          @default(100)
  mood          Float          @default(100)
  status        String         @default("alive") // alive | gone
  equipped      String         @default("{}") // JSON 字符串: { "hat": "key"|null, "neck": ..., "face": ... }
  decayedAt     DateTime       @default(now()) @map("decayed_at") // 上次衰减结算基准时刻
  criticalSince DateTime?      @map("critical_since") // 最早一项数值归零的时刻（判定离家出走）
  lastTouchAt   DateTime?      @map("last_touch_at") // 抚摸心情加成冷却
  pats          Int            @default(0) // 被其它用户撸的总次数（宠物之家人气）
  /**
   * 最近一次被对战夺走装备的日期（Asia/Shanghai YYYY-MM-DD），用于每日掉落保护
   */
  lastDropDate  String?        @map("last_drop_date")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  outfits       PetOutfit[]
  guestbook     PetGuestbook[]
  visits        PetVisit[]
  equipments    PetEquipment[]
  skills        PetSkill[]

  @@map("pets")
}

/**
 * 宠物之家留言板：访客在宠物之家留下的短留言（≤60 字），列表按宠物聚合。
 */
model PetGuestbook {
  id        Int      @id @default(autoincrement())
  petId     Int      @map("pet_id")
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  authorId  Int      @map("author_id")
  author    User     @relation("PetGuestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([petId, createdAt])
  @@index([authorId, createdAt])
  @@map("pet_guestbook")
}

/**
 * 宠物之家每日串门记录（每访客每宠物每天一行）：pats 为当天撸宠次数（限流 / 每日上限），
 * 宠物行的 pats 为累计人气。
 */
model PetVisit {
  id        Int      @id @default(autoincrement())
  petId     Int      @map("pet_id")
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  visitorId Int      @map("visitor_id")
  visitor   User     @relation("PetVisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  dateKey   String   @map("date_key") // Asia/Shanghai YYYY-MM-DD
  pats      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([petId, visitorId, dateKey])
  @@index([visitorId, dateKey])
  @@map("pet_visits")
}

/**
 * 已购买的宠物装扮（species 无关）；equipped JSON 只引用这里存在的 outfitKey。
 */
model PetOutfit {
  id        Int      @id @default(autoincrement())
  petId     Int      @map("pet_id")
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  outfitKey String   @map("outfit_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([petId, outfitKey])
  @@map("pet_outfits")
}

/**
 * 宠物战斗装备（永久拥有，petId + itemKey 唯一）。
 * bound=true 为绑定新手装，不可掉落、不可交易；acquiredVia: starter | shop | drop | market。
 * 穿戴状态存在 Pet.equipped JSON（weapon / armor / accessory），不在本表冗余。
 */
model PetEquipment {
  id          Int                @id @default(autoincrement())
  petId       Int                @map("pet_id")
  pet         Pet                @relation(fields: [petId], references: [id], onDelete: Cascade)
  itemKey     String             @map("item_key")
  bound       Boolean            @default(false)
  /**
   * 是否在交易行挂单中（同一物品最多一条 active 挂单）
   */
  listed      Boolean            @default(false)
  acquiredVia String             @default("shop") @map("acquired_via") // starter | shop | drop | market
  createdAt   DateTime           @default(now()) @map("created_at")
  listings    PetMarketListing[]

  @@unique([petId, itemKey])
  @@index([itemKey])
  @@map("pet_equipments")
}

/**
 * 宠物技能（永久拥有，petId + skillKey 唯一）。
 * 装备槽位存在 Pet.equipped JSON 的 skills 数组（最多 3 个），技能效果目录见 lib/petSkills.ts。
 */
model PetSkill {
  id          Int                @id @default(autoincrement())
  petId       Int                @map("pet_id")
  pet         Pet                @relation(fields: [petId], references: [id], onDelete: Cascade)
  skillKey    String             @map("skill_key")
  /**
   * 是否在交易行挂单中
   */
  listed      Boolean            @default(false)
  acquiredVia String             @default("shop") @map("acquired_via") // shop | market
  createdAt   DateTime           @default(now()) @map("created_at")
  listings    PetMarketListing[]

  @@unique([petId, skillKey])
  @@index([skillKey])
  @@map("pet_skills")
}

/**
 * 宠物对战（邀请 + 对局 + 结算同一行）。
 * status: pending（等待应战）| active（进行中）| finished | declined | expired。
 * state 为完整战斗状态 JSON（双方快照 / HP / MP / buff / 日志），version 用于行动乐观锁。
 */
model PetBattle {
  id               Int       @id @default(autoincrement())
  challengerId     Int       @map("challenger_id")
  challenger       User      @relation("PetBattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId       Int       @map("opponent_id")
  opponent         User      @relation("PetBattleOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  status           String    @default("pending") // pending | active | finished | declined | expired
  state            String    @default("{}") // JSON：BattleState
  version          Int       @default(0)
  turnUserId       Int?      @map("turn_user_id")
  turnDeadline     DateTime? @map("turn_deadline")
  challengerSeenAt DateTime? @map("challenger_seen_at")
  opponentSeenAt   DateTime? @map("opponent_seen_at")
  winnerId         Int?      @map("winner_id")
  loserId          Int?      @map("loser_id")
  rewardPoints     Int       @default(0) @map("reward_points")
  dropJson         String?   @map("drop_json") // JSON：{ itemType, itemKey, name }
  expiresAt        DateTime? @map("expires_at")
  settledAt        DateTime? @map("settled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([status, turnDeadline])
  @@index([status, expiresAt])
  @@map("pet_battles")
}

/**
 * 宠物交易行挂单：一条挂单对应一个具体的 PetEquipment / PetSkill 行（equipmentId / skillId）。
 * status: active | sold | cancelled。价格必须落在参考价 50%–150%。
 */
model PetMarketListing {
  id          Int              @id @default(autoincrement())
  sellerId    Int              @map("seller_id")
  seller      User             @relation("PetMarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemType    String           @map("item_type") // equipment | skill
  itemKey     String           @map("item_key")
  equipmentId Int?             @map("equipment_id")
  equipment   PetEquipment?    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  skillId     Int?             @map("skill_id")
  skill       PetSkill?        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  price       Int
  status      String           @default("active") // active | sold | cancelled
  buyerId     Int?             @map("buyer_id")
  buyer       User?            @relation("PetMarketBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  soldAt      DateTime?        @map("sold_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  trades      PetMarketTrade[]

  @@index([status, itemType, createdAt])
  @@index([sellerId, status])
  @@index([itemType, itemKey, status])
  @@map("pet_market_listings")
}

/**
 * 宠物交易行成交记录（append-only）：fee 为卖家支付的手续费（成交价 5%）。
 */
model PetMarketTrade {
  id            Int              @id @default(autoincrement())
  listingId     Int              @map("listing_id")
  listing       PetMarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId      Int              @map("seller_id")
  seller        User             @relation("PetMarketTradeSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId       Int              @map("buyer_id")
  buyer         User             @relation("PetMarketTradeBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  itemType      String           @map("item_type")
  itemKey       String           @map("item_key")
  price         Int
  fee           Int              @default(0)
  refPriceAfter Int              @map("ref_price_after")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([itemType, itemKey, createdAt])
  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
  @@map("pet_market_trades")
}

/**
 * 宠物交易行参考价（按 itemType + itemKey 唯一）：成交后向成交价靠拢，读取时惰性回归基础价。
 */
model PetMarketPrice {
  itemType  String   @map("item_type")
  itemKey   String   @map("item_key")
  refPrice  Int      @map("ref_price")
  basePrice Int      @map("base_price")
  trades    Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([itemType, itemKey])
  @@map("pet_market_prices")
}

// === 个人空间（管理员私人服务，每个管理员的数据互相隔离） ===

/**
 * 每个管理员一份个人空间（userId 唯一）；承载管理员私人服务配置（首个服务：RustDesk 远程桌面）。
 * RustDesk 四个字段均可空（String?），空值表示该项未配置。
 */
model PersonalSpace {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceName           String   @default("个人空间") @map("space_name") // 空间名（DB 默认「个人空间」；API 首访自动创建时取「<用户名> 的私人空间」）
  rustdeskIdServer    String?  @map("rustdesk_id_server") // RustDesk ID 服务器（如 rustdesk.example.com:21116）
  rustdeskRelayServer String?  @map("rustdesk_relay_server") // RustDesk 中继服务器
  rustdeskKey         String?  @map("rustdesk_key") // RustDesk 公钥 Key
  rustdeskWebClient   String?  @map("rustdesk_web_client") // RustDesk Web 客户端地址（http/https）
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("personal_spaces")
}

// === 小说阅读器 ===

/**
 * 用户上传的书籍（EPUB/TXT）。文件本体与封面存在储节点系统目录 _books/<userId>/ 下
 * （storageSync 已把 _books 列为系统目录，不进网盘；封面体积小不计网盘配额）。
 */
model Book {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String // epub 取 OPF 元数据；txt 取文件名（去扩展名）
  author      String         @default("")
  format      String // epub | txt
  size        Int // 文件字节数（计入网盘已用空间）
  storagePath String         @unique @map("storage_path") // 存储节点路径 _books/<userId>/<uuid>.<ext>
  coverPath   String?        @map("cover_path") // 封面节点路径（epub 内嵌封面缩略图，可空）
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  progress    BookProgress[] // 每个读者一行进度（BookProgress 按 [bookId, userId] 唯一）

  @@index([userId])
  @@map("books")
}

/**
 * 阅读进度（每本书每人一行）。location 对 epub 为 foliate CFI、对 txt 为 {chapter,offset} JSON 字符串；
 * percent 为 0–1 全书进度（列表页「继续阅读」展示用）。
 */
model BookProgress {
  id        Int      @id @default(autoincrement())
  bookId    Int      @map("book_id")
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  location  String   @default("")
  percent   Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bookId, userId])
  @@map("book_progress")
}

// === 网易云音乐 ===

/**
 * 每用户一条网易云扫码登录态（userId 唯一）。cookie（含 MUSIC_U）仅存服务端，
 * 永不出服务端、任何 API 响应不回传；解绑（logout）即删行。
 */
model MusicAccount {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookie     String // 网易云登录 cookie 串（敏感，不回传前端）
  nickname   String   @default("") // 绑定时缓存的昵称（展示用）
  avatarUrl  String   @default("") @map("avatar_url") // 绑定时缓存的头像 URL（展示用）
  loggedInAt DateTime @default(now()) @map("logged_in_at")

  @@map("music_accounts")
}

// === 模拟股市（2026-11 重构：AI 事件驱动 / 玩家冲击 / 无分红） ===

/**
 * 股市 AI 事件（每 40 分钟一批，append-only）。
 * source: ai（大模型生成）| template（模型不可用时的模板兜底）。
 * startTick 为当日 3 秒 tick 序号（0–28799），startAt 为其对应时刻；impact 带符号（正=利好）。
 */
model StockEvent {
  id         Int      @id @default(autoincrement())
  dateKey    String   @map("date_key") // Asia/Shanghai YYYY-MM-DD
  code       String
  batchKey   String   @map("batch_key") // 例如 2026-11-02T14:00（40 分钟槽）
  title      String
  summary    String
  sentiment  String   @default("good") // good | bad
  impact     Float
  halfLifeMs Int      @map("half_life_ms")
  startAt    DateTime @map("start_at")
  startTick  Int      @map("start_tick")
  source     String   @default("ai") // ai | template
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([dateKey, startAt])
  @@index([code, startAt])
  @@map("stock_events")
}

/**
 * 旧版股市账户（分红 / 已实现盈亏）。2026-11 起停止使用，仅保留历史数据，不参与任何计算。
 */
model StockAccount {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastDividendDate String?  @map("last_dividend_date")
  totalDividends   Int      @default(0) @map("total_dividends")
  realizedPoints   Int      @default(0) @map("realized_points")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("stock_accounts")
}

/**
 * 股市成交记录（买卖各一行，append-only）。
 * points：买入为投入积分（含手续费），卖出为到账积分；profit：仅卖出行有值（已实现盈亏）。
 */
model StockTrade {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  side      String // buy | sell
  shares    Float
  price     Float
  points    Int      @default(0)
  fee       Int      @default(0)
  profit    Int? // 卖出已实现盈亏（到账 - 分摊成本）
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([code, createdAt])
  @@map("stock_trades")
}

/**
 * 股市限价委托：买入时冻结积分（amount），卖出时冻结份额（shares + costPoints）。
 * 引擎在行情 / 委托 / 资产请求时惰性撮合（无定时器），status: open | filled | cancelled。
 */
model StockOrder {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  side        String // buy | sell
  limitPrice  Float     @map("limit_price")
  /**
   * 买入冻结积分（含手续费）；卖出为 0
   */
  amount      Int       @default(0)
  /**
   * 卖出冻结份额；买入为 0
   */
  shares      Float     @default(0)
  /**
   * 卖出冻结成本（用于已实现盈亏）
   */
  costPoints  Int       @default(0) @map("cost_points")
  status      String    @default("open") // open | filled | cancelled
  filledPrice Float?    @map("filled_price")
  filledAt    DateTime? @map("filled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, code, createdAt])
  @@index([userId, status])
  @@map("stock_orders")
}

// === 积分抽奖 ===

/**
 * 每用户一条抽奖账户（userId 唯一）：pity 为距上次稀有奖励的抽数（保底计数），
 * lastFreeDate 为每日免费抽使用日期（Asia/Shanghai YYYY-MM-DD）。
 */
model LotteryAccount {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pity         Int      @default(0)
  totalDraws   Int      @default(0) @map("total_draws")
  lastFreeDate String?  @map("last_free_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("lottery_accounts")
}

/**
 * 抽奖记录（append-only）。amount 为积分 / 种子数量等数值奖励，payload 为 JSON（种子 key、装扮等）。
 */
model LotteryDraw {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prizeKey  String   @map("prize_key")
  prizeType String   @map("prize_type") // points | seed | fertilizer | outfit | theme | nothing
  prizeName String   @map("prize_name")
  rarity    String   @default("common") // common | rare | epic | legendary
  amount    Int      @default(0)
  payload   String?
  cost      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("lottery_draws")
}

// === LineWeb 主题系统 ===

/**
 * 用户已解锁的主题（永久拥有，userId + themeKey 唯一）。
 * 主题目录与价格在 server/src/lib/themes.ts（代码内静态目录，不入库）。
 */
model ThemeUnlock {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeKey  String   @map("theme_key")
  price     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, themeKey])
  @@index([userId])
  @@map("theme_unlocks")
}

// === 宠物搜打撤（Delta Force 风格：搜索 / 战斗 / 撤离） ===

/**
 * 进行中的搜打撤对局（每人至多一局）。state 为完整对局 JSON（地图 / 视野 / 敌人 / 战利品 / 日志）。
 * status: active | extracted | died | mia | abandoned。
 */
model PetRaid {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapKey     String    @map("map_key")
  difficulty String    @default("normal")
  status     String    @default("active")
  state      String    @default("{}")
  version    Int       @default(0)
  seed       Int
  startedAt  DateTime  @default(now()) @map("started_at")
  expiresAt  DateTime  @map("expires_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@map("pet_raids")
}

/**
 * 搜打撤战绩（append-only，含本局带出的战利品摘要）。
 */
model PetRaidRecord {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapKey     String   @map("map_key")
  difficulty String   @map("difficulty")
  result     String // extracted | died | mia | abandoned
  points     Int      @default(0)
  lootJson   String?  @map("loot_json")
  kills      Int      @default(0)
  moves      Int      @default(0)
  durationMs Int      @default(0) @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([result, createdAt])
  @@map("pet_raid_records")
}

/**
 * 搜打撤每日契约（3 条/天，进度由服务端结算，领取发积分）。
 */
model PetRaidContract {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey      String   @map("date_key")
  contractKey  String   @map("contract_key")
  target       Int
  progress     Int      @default(0)
  claimed      Boolean  @default(false)
  rewardPoints Int      @default(0) @map("reward_points")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, dateKey, contractKey])
  @@index([userId, dateKey])
  @@map("pet_raid_contracts")
}

// === 搜打撤仓库 / 交易行（撤离战利品入仓 + 玩家间材料交易） ===

/**
 * 搜打撤仓库（每用户一行）。等级 1–6，容量 / 保险箱格数由
 * server/src/lib/raidStorage.ts 的 RAID_STORAGE_LEVELS 派生。
 */
model RaidStorage {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Int      @default(1) // 仓库等级 1–6，容量/保险箱格数由 RAID_STORAGE_LEVELS 派生
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("raid_storage")
}

/**
 * 搜打撤仓库物品（按 [userId, itemKey] 聚合数量）。
 * listedAmount 为已被在售挂单预留的数量，恒有 amount >= listedAmount（写路径守卫保证）。
 */
model RaidInventoryItem {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey      String   @map("item_key") // RAID_LOOT_ENTRIES.key
  amount       Int      @default(0)
  listedAmount Int      @default(0) @map("listed_amount") // 已被在售挂单预留的数量，恒有 amount >= listedAmount
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, itemKey])
  @@map("raid_inventory_items")
}

/**
 * 搜打撤交易行挂单（整单出售，不支持部分购买）。
 * itemName / rarity / value 为挂单时的目录快照，防目录调整影响历史挂单。
 */
model RaidMarketListing {
  id        Int       @id @default(autoincrement())
  sellerId  Int       @map("seller_id")
  seller    User      @relation("RaidMarketListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemKey   String    @map("item_key")
  itemName  String    @map("item_name") // 目录名快照
  rarity    String // 稀有度快照
  value     Int // 单件目录价值快照（定价基准）
  amount    Int
  price     Int // 整单总价（积分）
  status    String    @default("active") // active | sold | cancelled
  buyerId   Int?      @map("buyer_id")
  buyer     User?     @relation("RaidMarketListingBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  soldAt    DateTime? @map("sold_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([sellerId, status])
  @@map("raid_market_listings")
}

/**
 * 搜打撤交易行成交记录（append-only）。fee 为卖家手续费（5% 向上取整，最低 1）。
 */
model RaidMarketTrade {
  id        Int      @id @default(autoincrement())
  listingId Int?     @map("listing_id")
  sellerId  Int      @map("seller_id")
  buyerId   Int      @map("buyer_id")
  itemKey   String   @map("item_key")
  itemName  String   @map("item_name")
  amount    Int
  price     Int // 整单成交总价
  fee       Int // 卖家手续费
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("raid_market_trades")
}
