# ============================================================
# LineWeb 容器化部署（备选）环境变量 — 阿里云 ECS（Ubuntu）
#
# 说明：ECS 上的运行方式（systemd 直接跑 Node/tsx vs Docker Compose）尚未最终确定，
#       本文件对应容器化那一种，属于**备选方案**。
# 前置: PostgreSQL 场景 → 创建 lineweb 库；SQLite 场景 → 见下方变体
# 使用: cp .env.docker .env → 修改下面几项 → docker compose up -d
# ============================================================

# ---- 数据库连接（二选一） ----
#
# 变体 A：PostgreSQL（现有 compose 的前提，1Panel 面板部署时使用）
# 1Panel 数据库面板 → 连接信息 → 复制，替换下面用户/密码/库名
# PG 容器名填实际名称（1Panel → 容器 可查到，如 1Panel-postgresql-eIQH）
DATABASE_URL=postgresql://postgres:你的PG密码@1Panel-postgresql-eIQH:5432/lineweb
#
# 变体 B：SQLite（与仓库现行约定一致 —— server/prisma/schema.prisma 就是 SQLite，
#         约定只用 `prisma db push`）。选择此项时注释掉变体 A。
#         注意相对路径按 schema 所在目录解析：`file:./lineweb.db` 即容器内
#         /app/server/prisma/lineweb.db，要持久化必须把数据卷挂到该目录；
#         或直接写绝对路径，并在 docker-compose.yml 中把卷挂到同一位置：
# DATABASE_URL="file:/var/lib/lineweb/lineweb.db"

# ---- JWT 密钥（务必换成随机字符串！） ----
# 生成随机密钥: openssl rand -hex 32
JWT_SECRET=请替换为随机字符串至少32字符

# ---- Server 端口（1Panel 反向代理指向此端口） ----
PORT=3001
NODE_ENV=production

# ---- 以下可选 ----
STORAGE_NODE_TOKEN=
MAX_FILE_SIZE_MB=10240
