# ============================================================
# LineWeb 容器化部署环境变量 — 阿里云 ECS（Ubuntu，**生产主线**）
#
# 说明：生产采用 1Panel + Docker Compose（Express 容器 + PostgreSQL 16 容器），
#       本文件是生产 .env 模板；真正的生产文件在服务器 /opt/lineweb/.env（不进仓库）。
#       systemd 直接跑 Node/tsx 与 PM2 仅作备选。
# 前置: PostgreSQL 场景 → 创建 lineweb 库；SQLite 场景 → 见下方变体
# 使用: cp .env.docker .env → 修改下面几项 → docker compose up -d
# ============================================================

# ---- 数据库连接（二选一） ----
#
# 变体 A：PostgreSQL（现有 compose 的前提，1Panel 面板部署时使用）
# 1Panel 数据库面板 → 连接信息 → 复制，替换下面用户/密码/库名
# PG 容器名填实际名称（1Panel → 容器 可查到，如 1Panel-postgresql-eIQH）
DATABASE_URL=postgresql://postgres:你的PG密码@1Panel-postgresql-eIQH:5432/lineweb
#
# 变体 B：SQLite（与仓库现行约定一致 —— server/prisma/schema.prisma 就是 SQLite，
#         约定只用 `prisma db push`）。选择此项时注释掉变体 A。
#         注意相对路径按 schema 所在目录解析：`file:./lineweb.db` 即容器内
#         /app/server/prisma/lineweb.db，要持久化必须把数据卷挂到该目录；
#         或直接写绝对路径，并在 docker-compose.yml 中把卷挂到同一位置：
# DATABASE_URL="file:/var/lib/lineweb/lineweb.db"

# ---- JWT 密钥（务必换成随机字符串！） ----
# 生成随机密钥: openssl rand -hex 32
JWT_SECRET=请替换为随机字符串至少32字符

# ---- Server 端口（1Panel 反向代理指向此端口） ----
PORT=3001
NODE_ENV=production

# ---- 以下可选 ----
STORAGE_NODE_TOKEN=
MAX_FILE_SIZE_MB=10240

# ---- 自建聊天（2026-10 起） ----
# 会话/消息/群聊全部落 Prisma，无外部服务依赖，零配置即可用。
# LineWeb 用户大群：服务端自动创建并维护成员
CHAT_BIG_GROUP_ENABLED=true
CHAT_BIG_GROUP_NAME=LineWeb 用户群
# 成员对账周期（毫秒，默认 10 分钟）
CHAT_BIG_GROUP_SYNC_INTERVAL=600000

# ---- 聊天双后端（可选）：XMPP（neko） ----
# 配置后用户可在聊天设置里把聊天切回 XMPP 服务（看到 neko 上的历史消息）；
# 不配置则「聊天服务」选项不出现，以下全部留空即可。
NEKO_CHAT_ENABLED=false
NEKO_CHAT_INTERNAL_URL=
NEKO_CHAT_TOKEN=
NEKO_CHAT_WS_PATH=/xmpp-websocket
NEKO_CHAT_ACCOUNT_BASE=1000000000000
NEKO_CHAT_USERNAME_PREFIX=lw_
NEKO_CHAT_ALLOW_NATIVE=true
NEKO_CHAT_TIMEOUT_MS=10000
NEKO_LINEWEB_GROUP_ENABLED=true
NEKO_LINEWEB_GROUP_NAME=LineWeb 用户群
NEKO_LINEWEB_GROUP_SYNC_INTERVAL=600000
