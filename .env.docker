# ============================================================
# LineWeb Docker 环境变量（Ubuntu + 1Panel + PostgreSQL）
#
# 前置: 1Panel → 数据库 → PostgreSQL → 创建 lineweb 库
# 使用: cp .env.docker .env → 修改下面三项 → docker compose up -d
# ============================================================

# ---- 数据库连接（1Panel PostgreSQL） ----
# 1Panel 数据库面板 → 连接信息 → 复制，替换下面用户/密码/库名
# host.docker.internal = 容器访问宿主机固定地址，不要改
DATABASE_URL=postgresql://postgres:你的PG密码@host.docker.internal:5432/lineweb

# ---- JWT 密钥（务必换成随机字符串！） ----
# 生成随机密钥: openssl rand -hex 32
JWT_SECRET=请替换为随机字符串至少32字符

# ---- Server 端口（1Panel 反向代理指向此端口） ----
PORT=3001
NODE_ENV=production

# ---- 以下可选 ----
STORAGE_NODE_TOKEN=
MAX_FILE_SIZE_MB=10240
